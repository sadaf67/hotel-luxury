@model IEnumerable<Hotel.Domain.Entities.SiteSetting>
@{ViewBag.Title="تنظیمات سایت";ViewBag.Active="settings";}
<form asp-action="SaveSettings" method="post">@Html.AntiForgeryToken()<div class="admin-card"><div class="admin-card-header"><h3><i class="fas fa-sliders-h"></i> اطلاعات عمومی و تماس</h3><button class="btn btn-gold"><i class="fas fa-save"></i> ذخیره همه</button></div><div class="admin-card-body"><div class="admin-form-grid">@foreach(var item in Model){<div class="form-group @(item.Key=="AboutText"?"admin-full":"")"><label>@(item.Description??item.Key)</label>@if(item.Key=="AboutText"){<textarea name="settings[@item.Key]" class="form-control" rows="4">@item.Value</textarea>}else{<input name="settings[@item.Key]" value="@item.Value" class="form-control"/>}<small>@item.Group · @item.Key</small></div>}</div></div></div></form>
