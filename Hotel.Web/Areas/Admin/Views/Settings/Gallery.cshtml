@model IEnumerable<Hotel.Domain.Entities.Gallery>
@{ViewBag.Title="مدیریت گالری";ViewBag.Active="gallery";}
<div class="admin-card"><div class="admin-card-header"><h3><i class="fas fa-image"></i> افزودن تصویر</h3></div><div class="admin-card-body"><form asp-action="AddGalleryImage" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div class="admin-form-grid"><input name="title" class="form-control" placeholder="عنوان" required/><input name="category" class="form-control" placeholder="دسته: هتل، اتاق، استخر..."/><input name="image" type="file" accept="image/*" class="form-control" required/><button class="btn btn-gold">بارگذاری تصویر</button></div></form></div></div><div class="admin-gallery-grid">@foreach(var x in Model){<figure><img src="@x.ImagePath" alt="@x.Title"/><figcaption><b>@x.Title</b><small>@x.Category</small></figcaption></figure>}</div>
