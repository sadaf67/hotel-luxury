@model IEnumerable<Hotel.Domain.Entities.Slider>
@{ViewBag.Title="اسلایدر صفحه اصلی";ViewBag.Active="sliders";}
@Html.AntiForgeryToken()
<div class="admin-card"><div class="admin-card-header"><h3><i class="fas fa-plus"></i> اسلاید جدید</h3></div><div class="admin-card-body"><form asp-action="AddSlider" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div class="admin-form-grid"><input name="Title" class="form-control" placeholder="عنوان" required/><input name="Subtitle" class="form-control" placeholder="زیرعنوان"/><input name="ButtonText" class="form-control" placeholder="متن دکمه"/><input name="ButtonUrl" class="form-control" placeholder="/Home/Rooms"/><input name="image" type="file" accept="image/*" class="form-control" required/><input name="SortOrder" type="number" class="form-control" placeholder="ترتیب"/></div><button class="btn btn-gold">افزودن اسلاید</button></form></div></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>تصویر</th><th>عنوان</th><th>ترتیب</th><th>عملیات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><img src="@x.ImagePath" style="width:100px;height:58px;object-fit:cover;border-radius:8px"/></td><td>@x.Title</td><td>@x.SortOrder</td><td><button class="btn btn-dark btn-sm" onclick="deleteItem('/Admin/Settings/DeleteSlider/@x.Id',document.querySelector('[name=__RequestVerificationToken]').value)"><i class="fas fa-trash"></i></button></td></tr>}</tbody></table></div>
