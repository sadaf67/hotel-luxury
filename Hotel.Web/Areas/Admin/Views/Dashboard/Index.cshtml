@model Hotel.Application.DTOs.DashboardStatsDto
@{
    ViewBag.Title  = "داشبورد";
    ViewBag.Active = "dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- ===== STATS CARDS ===== -->
<div class="stats-cards">
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
        <div class="stat-info">
            <div class="value">@Model.TotalReservations</div>
            <div class="label">کل رزروها</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(255,193,7,.1)"><i class="fas fa-clock" style="color:#ffc107"></i></div>
        <div class="stat-info">
            <div class="value">@Model.PendingReservations</div>
            <div class="label">در انتظار تایید</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(46,204,113,.1)"><i class="fas fa-users" style="color:#2ecc71"></i></div>
        <div class="stat-info">
            <div class="value">@Model.ActiveGuests</div>
            <div class="label">مهمانان فعال</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(52,152,219,.1)"><i class="fas fa-bed" style="color:#3498db"></i></div>
        <div class="stat-info">
            <div class="value">@Model.AvailableRooms / @Model.TotalRooms</div>
            <div class="label">اتاق آزاد</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-coins"></i></div>
        <div class="stat-info">
            <div class="value" style="font-size:1.1rem">@Model.MonthlyRevenue.ToString("N0")</div>
            <div class="label">درآمد ماه جاری (تومان)</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(231,76,60,.1)"><i class="fas fa-envelope" style="color:#e74c3c"></i></div>
        <div class="stat-info">
            <div class="value">@Model.UnreadMessages</div>
            <div class="label">پیام‌های خوانده‌نشده</div>
        </div>
    </div>
</div>

<!-- ===== امروز ===== -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px">
    <div class="admin-card" style="border-right:3px solid var(--gold)">
        <div class="admin-card-header">
            <h3><i class="fas fa-sign-in-alt"></i> چک‌این امروز</h3>
        </div>
        <div class="admin-card-body" style="text-align:center;padding:20px">
            <div style="font-size:3rem;font-weight:900;color:var(--gold)">@Model.TodayCheckIns</div>
            <div style="color:var(--text-muted);font-size:.85rem">ورودی امروز</div>
        </div>
    </div>
    <div class="admin-card" style="border-right:3px solid #3498db">
        <div class="admin-card-header">
            <h3><i class="fas fa-sign-out-alt"></i> چک‌اوت امروز</h3>
        </div>
        <div class="admin-card-body" style="text-align:center;padding:20px">
            <div style="font-size:3rem;font-weight:900;color:#3498db">@Model.TodayCheckOuts</div>
            <div style="color:var(--text-muted);font-size:.85rem">خروجی امروز</div>
        </div>
    </div>
</div>

<!-- ===== نمودار درآمد ===== -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3><i class="fas fa-chart-bar"></i> نمودار درآمد ۶ ماه اخیر</h3>
        <span style="color:var(--text-muted);font-size:.8rem">تومان</span>
    </div>
    <div class="admin-card-body">
        <div class="chart-wrap">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>
</div>

<!-- ===== دسترسی سریع ===== -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3><i class="fas fa-bolt"></i> دسترسی سریع</h3>
    </div>
    <div class="admin-card-body">
        <div style="display:flex;flex-wrap:wrap;gap:12px">
            <a href="/Admin/Rooms/Create"       class="btn btn-gold btn-sm"><i class="fas fa-plus"></i> اتاق جدید</a>
            <a href="/Admin/Discounts/Create"   class="btn btn-outline btn-sm"><i class="fas fa-tag"></i> کد تخفیف</a>
            <a href="/Admin/Sms/Send"           class="btn btn-dark btn-sm"><i class="fas fa-sms"></i> ارسال پیامک</a>
            <a href="/Admin/Settings/Sliders"   class="btn btn-dark btn-sm"><i class="fas fa-images"></i> ویرایش اسلایدر</a>
            <a href="/Admin/Settings"           class="btn btn-dark btn-sm"><i class="fas fa-cog"></i> تنظیمات</a>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    const gridColor = isDark ? 'rgba(212,175,55,.1)' : 'rgba(168,134,14,.15)';
    const textColor = isDark ? '#888' : '#666';

    const ctx = document.getElementById('revenueChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: [@Html.Raw(string.Join(",", Model.RevenueChart.Select(r => $"'{r.Month}'")))],
            datasets: [{
                label: 'درآمد (تومان)',
                data: [@string.Join(",", Model.RevenueChart.Select(r => r.Amount))],
                backgroundColor: 'rgba(212,175,55,.25)',
                borderColor: '#D4AF37',
                borderWidth: 2,
                borderRadius: 8,
                hoverBackgroundColor: 'rgba(212,175,55,.5)'
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { labels: { color: textColor, font: { family: 'Vazirmatn' } } } },
            scales: {
                x: { grid: { color: gridColor }, ticks: { color: textColor } },
                y: { grid: { color: gridColor }, ticks: { color: textColor, callback: v => v.toLocaleString('fa-IR') } }
            }
        }
    });
</script>
}
