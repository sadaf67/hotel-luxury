@model List<Hotel.Domain.Entities.PoolSession>
@{ViewBag.Title="مدیریت استخر";ViewBag.Active="pool";}
@Html.AntiForgeryToken()
<div class="admin-card"><div class="admin-card-header"><h3><i class="fas fa-swimming-pool"></i> تعریف سانس</h3></div><div class="admin-card-body"><form asp-action="Save" method="post"><div class="admin-form-grid"><input name="Title" class="form-control" placeholder="عنوان سانس" required/><input name="StartTime" type="time" class="form-control" required/><input name="EndTime" type="time" class="form-control" required/><input name="MaxCapacity" type="number" min="1" class="form-control" placeholder="ظرفیت"/><input name="AdultPrice" type="number" min="0" class="form-control" placeholder="قیمت بزرگسال"/><input name="ChildPrice" type="number" min="0" class="form-control" placeholder="قیمت کودک"/><textarea name="Description" class="form-control admin-full" placeholder="توضیحات"></textarea></div><input type="hidden" name="IsActive" value="true"/><button class="btn btn-gold">ذخیره سانس</button></form></div></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>عنوان</th><th>ساعت</th><th>ظرفیت</th><th>بزرگسال</th><th>کودک</th><th>عملیات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Title</td><td>@x.StartTime.ToString(@"hh\:mm") تا @x.EndTime.ToString(@"hh\:mm")</td><td>@x.MaxCapacity</td><td>@x.AdultPrice.ToString("N0")</td><td>@x.ChildPrice.ToString("N0")</td><td><button class="btn btn-dark btn-sm" onclick="deleteItem('/Admin/Pool/Delete/@x.Id',document.querySelector('[name=__RequestVerificationToken]').value)"><i class="fas fa-trash"></i></button></td></tr>}</tbody></table></div>
