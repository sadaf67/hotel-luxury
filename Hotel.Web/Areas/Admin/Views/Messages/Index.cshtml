@model List<Hotel.Domain.Entities.ContactMessage>
@{ ViewBag.Title="پیام‌های مهمانان"; ViewBag.Active="messages"; }
<div class="table-toolbar"><h3><i class="fas fa-inbox"></i> صندوق پیام‌ها (@Model.Count)</h3><div style="display:flex;gap:8px"><a href="/Admin/Messages" class="btn btn-dark btn-sm">همه</a><a href="/Admin/Messages?unreadOnly=true" class="btn btn-gold btn-sm">خوانده‌نشده</a></div></div>
<div class="message-inbox">
@foreach(var message in Model){<article class="message-card @(!message.IsRead?"unread":"")"><header><div class="message-avatar">@message.Name.Trim().FirstOrDefault()</div><div><h3>@message.Name</h3><span dir="ltr">@message.Phone · @message.Email</span></div><time>@message.CreatedAt.ToString("yyyy/MM/dd HH:mm")</time></header><div class="message-subject">@message.Subject</div><p>@message.Message</p>@if(!string.IsNullOrWhiteSpace(message.AdminReply)){<div class="saved-reply"><i class="fas fa-reply"></i><span>@message.AdminReply</span></div>}<footer>@if(!message.IsRead){<form asp-action="MarkRead" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@message.Id"/><button class="btn btn-dark btn-sm">علامت‌گذاری خوانده‌شده</button></form>}<form asp-action="Reply" method="post" class="inline-reply">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@message.Id"/><input name="reply" class="form-control" maxlength="2000" placeholder="یادداشت یا پاسخ مدیریت..." required/><button class="btn btn-gold btn-sm">ذخیره پاسخ</button></form></footer></article>}
@if(!Model.Any()){<div class="empty-state"><i class="fas fa-inbox"></i><h3>پیامی وجود ندارد</h3></div>}
</div>
