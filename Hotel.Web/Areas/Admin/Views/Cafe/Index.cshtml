@model List<Hotel.Domain.Entities.CafeCategory>
@{ViewBag.Title="مدیریت کافی‌شاپ";ViewBag.Active="cafe";}
@Html.AntiForgeryToken()
<div class="admin-form-grid"><div class="admin-card"><div class="admin-card-header"><h3>دسته جدید</h3></div><div class="admin-card-body"><form asp-action="AddCategory" method="post">@Html.AntiForgeryToken()<input name="name" class="form-control" placeholder="مثلاً قهوه‌های گرم" required/><button class="btn btn-gold" style="margin-top:12px">افزودن دسته</button></form></div></div><div class="admin-card"><div class="admin-card-header"><h3>آیتم منو</h3></div><div class="admin-card-body"><form asp-action="AddItem" method="post">@Html.AntiForgeryToken()<select name="CategoryId" class="form-control" required>@foreach(var c in Model){<option value="@c.Id">@c.Name</option>}</select><input name="Name" class="form-control" placeholder="نام آیتم" required/><input name="Price" type="number" min="0" class="form-control" placeholder="قیمت" required/><textarea name="Description" class="form-control" placeholder="توضیح کوتاه"></textarea><input type="hidden" name="IsAvailable" value="true"/><button class="btn btn-gold">افزودن به منو</button></form></div></div></div>
@foreach(var c in Model){<div class="admin-card"><div class="admin-card-header"><h3><i class="fas fa-coffee"></i> @c.Name</h3><span class="badge badge-gold">@c.MenuItems.Count آیتم</span></div><div class="admin-card-body"><div class="menu-admin-list">@foreach(var x in c.MenuItems){<div><span><b>@x.Name</b><small>@x.Description</small></span><strong>@x.Price.ToString("N0") تومان</strong><button class="btn btn-dark btn-sm" onclick="deleteItem('/Admin/Cafe/DeleteItem/@x.Id',document.querySelector('[name=__RequestVerificationToken]').value)"><i class="fas fa-trash"></i></button></div>}</div></div></div>}
