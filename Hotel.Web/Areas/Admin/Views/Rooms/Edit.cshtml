@model Hotel.Domain.Entities.Room
@{ViewBag.Title="ویرایش اتاق";ViewBag.Active="rooms";}
<div class="admin-card"><div class="admin-card-header"><h3><i class="fas fa-edit"></i> ویرایش @Model.Name</h3><a asp-action="Index" class="btn btn-dark btn-sm">بازگشت</a></div><div class="admin-card-body"><form method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><partial name="_Form" model="Model"/><div class="form-group"><label>تصاویر گالری</label><input type="file" name="galleryImages" multiple accept=".jpg,.jpeg,.png,.webp" class="form-control"/></div><button class="btn btn-gold"><i class="fas fa-save"></i> ذخیره تغییرات</button></form></div></div>
