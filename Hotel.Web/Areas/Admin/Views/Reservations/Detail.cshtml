@model Hotel.Domain.Entities.Reservation
@{ViewBag.Title="جزئیات رزرو";ViewBag.Active="reservations";}
@Html.AntiForgeryToken()
<div class="admin-card"><div class="admin-card-header"><h3><i class="fas fa-receipt"></i> رزرو @Model.TrackingCode</h3><a asp-action="Index" class="btn btn-dark btn-sm">بازگشت</a></div><div class="admin-card-body"><div class="detail-data-grid"><div><small>مهمان</small><b>@Model.GuestName</b></div><div><small>موبایل</small><b dir="ltr">@Model.GuestPhone</b></div><div><small>ایمیل</small><b>@Model.GuestEmail</b></div><div><small>کد ملی</small><b>@Model.NationalCode</b></div><div><small>اتاق</small><b>@Model.Room?.Name (@Model.Room?.RoomNumber)</b></div><div><small>تعداد مهمان</small><b>@Model.GuestsCount نفر</b></div><div><small>ورود</small><b>@Model.CheckIn.ToString("yyyy/MM/dd")</b></div><div><small>خروج</small><b>@Model.CheckOut.ToString("yyyy/MM/dd")</b></div><div><small>مبلغ نهایی</small><b style="color:var(--gold)">@Model.FinalPrice.ToString("N0") تومان</b></div><div><small>درخواست خاص</small><b>@(Model.SpecialRequests??"—")</b></div></div><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px"><button class="btn btn-gold" onclick="updateStatus(@Model.Id,1,document.querySelector('[name=__RequestVerificationToken]').value)">تایید رزرو</button><button class="btn btn-dark" onclick="updateStatus(@Model.Id,2,document.querySelector('[name=__RequestVerificationToken]').value)">ثبت ورود</button><button class="btn btn-dark" onclick="updateStatus(@Model.Id,3,document.querySelector('[name=__RequestVerificationToken]').value)">ثبت خروج</button><button class="btn btn-danger" onclick="updateStatus(@Model.Id,4,document.querySelector('[name=__RequestVerificationToken]').value)">لغو</button></div></div></div>
