@model Hotel.Domain.Entities.Discount
@{ViewBag.Title="ویرایش کد تخفیف";ViewBag.Active="discounts";}
<div class="admin-card" style="max-width:760px"><div class="admin-card-header"><h3><i class="fas fa-tag"></i> ویرایش @Model.Code</h3><a asp-action="Index" class="btn btn-dark btn-sm">بازگشت</a></div><div class="admin-card-body"><form method="post">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div class="admin-form-grid"><div class="form-group"><label>کد</label><input asp-for="Code" class="form-control"/></div><div class="form-group"><label>عنوان</label><input asp-for="Title" class="form-control"/></div><div class="form-group"><label>نوع</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<Hotel.Domain.Enums.DiscountType>()" class="form-control"></select></div><div class="form-group"><label>مقدار</label><input asp-for="Value" type="number" class="form-control"/></div><div class="form-group"><label>حداقل خرید</label><input asp-for="MinimumAmount" type="number" class="form-control"/></div><div class="form-group"><label>سقف تخفیف</label><input asp-for="MaximumDiscount" type="number" class="form-control"/></div><div class="form-group"><label>شروع</label><input asp-for="StartDate" type="date" class="form-control"/></div><div class="form-group"><label>پایان</label><input asp-for="EndDate" type="date" class="form-control"/></div><div class="form-group"><label>حداکثر استفاده</label><input asp-for="MaxUsageCount" type="number" class="form-control"/></div><div class="form-group"><label><input asp-for="IsActive"/> فعال</label></div><div class="form-group admin-full"><label>توضیحات</label><textarea asp-for="Description" class="form-control"></textarea></div></div><button class="btn btn-gold">ذخیره تغییرات</button></form></div></div>
