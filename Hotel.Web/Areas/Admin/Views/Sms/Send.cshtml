@{ViewBag.Title="ارسال پیامک";ViewBag.Active="sms";}
<div class="admin-card" style="max-width:720px"><div class="admin-card-header"><h3><i class="fas fa-paper-plane"></i> پیام جدید</h3><a asp-action="Index" class="btn btn-dark btn-sm">تاریخچه</a></div><div class="admin-card-body"><form method="post">@Html.AntiForgeryToken()<div class="form-group"><label>شماره موبایل</label><input name="phone" dir="ltr" class="form-control" placeholder="09xxxxxxxxx" required/></div><div class="form-group"><label>متن پیام</label><textarea name="message" rows="5" maxlength="500" class="form-control" required></textarea></div><button class="btn btn-gold">ارسال پیامک</button></form><hr style="border-color:var(--border);margin:30px 0"/><form asp-action="SendBulk" method="post">@Html.AntiForgeryToken()<input type="hidden" name="target" value="all_guests"/><div class="form-group"><label>ارسال برای همه مهمانان</label><textarea name="message" rows="4" class="form-control" required></textarea></div><button class="btn btn-dark">ارسال گروهی</button></form></div></div>
