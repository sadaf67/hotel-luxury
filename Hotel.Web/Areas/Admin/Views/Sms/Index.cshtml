@{
    ViewBag.Title  = "پنل پیامک";
    ViewBag.Active = "sms";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var logs = Model as IEnumerable<Hotel.Domain.Entities.SmsLog> ?? new List<Hotel.Domain.Entities.SmsLog>();
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:28px">

    <!-- ارسال تک پیامک -->
    <div class="admin-card">
        <div class="admin-card-header">
            <h3><i class="fas fa-paper-plane"></i> ارسال پیامک دستی</h3>
        </div>
        <div class="admin-card-body">
            <form asp-action="Send" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>شماره موبایل</label>
                    <input name="phone" class="form-control" placeholder="09xxxxxxxxx" dir="ltr" />
                </div>
                <div class="form-group">
                    <label>متن پیام</label>
                    <textarea name="message" class="form-control" rows="4" placeholder="متن پیامک..."></textarea>
                </div>
                <button type="submit" class="btn btn-gold w-100"><i class="fas fa-paper-plane"></i> ارسال پیامک</button>
            </form>
        </div>
    </div>

    <!-- ارسال دسته‌جمعی -->
    <div class="admin-card">
        <div class="admin-card-header">
            <h3><i class="fas fa-broadcast-tower"></i> ارسال دسته‌جمعی</h3>
        </div>
        <div class="admin-card-body">
            <form asp-action="SendBulk" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>گروه دریافت‌کنندگان</label>
                    <select name="target" class="form-control">
                        <option value="all_guests">همه مهمانان رزرو کرده</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>متن پیام</label>
                    <textarea name="message" class="form-control" rows="4" placeholder="متن پیامک تبلیغاتی..."></textarea>
                </div>
                <div style="background:rgba(212,175,55,.08);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px;margin-bottom:16px;font-size:.82rem;color:var(--text-muted)">
                    <i class="fas fa-info-circle" style="color:var(--gold)"></i>
                    پیامک برای تمام شماره‌های موجود در سیستم ارسال خواهد شد.
                </div>
                <button type="submit" class="btn btn-outline w-100"><i class="fas fa-broadcast-tower"></i> ارسال دسته‌جمعی</button>
            </form>
        </div>
    </div>
</div>

<!-- لاگ پیامک‌ها -->
<div class="admin-table-wrap">
    <div class="table-toolbar">
        <h3><i class="fas fa-history"></i> تاریخچه ارسال‌ها (@logs.Count())</h3>
    </div>
    <div style="overflow-x:auto">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>شماره</th>
                    <th>متن پیام</th>
                    <th>وضعیت</th>
                    <th>ارسال توسط</th>
                    <th>تاریخ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in logs)
                {
                    <tr>
                        <td style="direction:ltr">@log.PhoneNumber</td>
                        <td style="max-width:300px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="@log.Message">@log.Message</td>
                        <td>
                            <span class="badge @(log.Status == Hotel.Domain.Enums.SmsStatus.Sent ? "badge-success" : log.Status == Hotel.Domain.Enums.SmsStatus.Failed ? "badge-danger" : "badge-warning")">
                                @(log.Status == Hotel.Domain.Enums.SmsStatus.Sent ? "ارسال شد" : log.Status == Hotel.Domain.Enums.SmsStatus.Failed ? "خطا" : "در صف")
                            </span>
                        </td>
                        <td>@(log.SentBy ?? "سیستم")</td>
                        <td>@log.CreatedAt.ToString("yy/MM/dd HH:mm")</td>
                    </tr>
                }
                @if (!logs.Any())
                {
                    <tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text-muted)">هنوز پیامکی ارسال نشده</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
